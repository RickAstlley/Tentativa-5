{
  "entities": {
    "EBikeReview": {
      "title": "EBikeReview",
      "description": "Avaliação e relato da comunidade de ciclistas para um modelo de e-bike específico",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bikeSlug": { "type": "string" },
        "author": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 60 },
        "userWeightKg": { "type": "number" },
        "usageProfile": { "type": "string", "maxLength": 100 },
        "terrain": { "type": "string", "enum": ["plano", "misto", "íngreme"] },
        "assistanceModeUsed": { "type": "string", "maxLength": 80 },
        "realRangeKm": { "type": "number" },
        "advertisedRangeKm": { "type": "number" },
        "rating": { "type": "number" },
        "criteria": {
          "type": "object",
          "properties": {
            "batteryAutonomy": { "type": "number" },
            "motorPower": { "type": "number" },
            "comfort": { "type": "number" },
            "reliability": { "type": "number" }
          }
        },
        "date": { "type": "string" },
        "timeUsing": { "type": "string", "maxLength": 60 },
        "title": { "type": "string", "maxLength": 120 },
        "comment": { "type": "string", "maxLength": 1500 },
        "verified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "helpfulCount": { "type": "number" }
      },
      "required": ["id", "bikeSlug", "author", "rating", "realRangeKm", "title", "comment", "date"]
    },
    "ExtractionStaging": {
      "title": "ExtractionStaging",
      "description": "Ambiente de isolamento e staging no banco de dados para arquivos, manuais e caches intermediários de IA sem impacto no catálogo de bikes",
      "type": "object",
      "properties": {
        "cacheId": { "type": "string", "maxLength": 128 },
        "fileHash": { "type": "string", "maxLength": 128 },
        "fileName": { "type": "string", "maxLength": 255 },
        "fileType": { "type": "string", "maxLength": 60 },
        "fileSizeBytes": { "type": "number" },
        "extractedAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "mode": { "type": "string", "enum": ["ebike", "article", "ranking"] },
        "status": { "type": "string" },
        "rawText": { "type": "string" },
        "structuredYaml": { "type": "string" },
        "currentStageLabel": { "type": "string", "maxLength": 200 }
      },
      "required": ["cacheId", "fileHash", "fileName", "mode", "status", "extractedAt", "updatedAt"]
    }
  },
  "firestore": {
    "/reviews/{reviewId}": {
      "schema": "EBikeReview",
      "description": "Coleção global e auditada de avaliações da comunidade de ciclistas"
    },
    "/extraction_staging/{cacheId}": {
      "schema": "ExtractionStaging",
      "description": "Coleção isolada no banco de dados para arquivos brutos, metadados e caches do pipeline de descompactação"
    }
  }
}
