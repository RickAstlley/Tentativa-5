# CONFIGURAÇÕES DE AMBIENTE E PRODUÇÃO — TUAVIA
# Este arquivo é somente um modelo. Cadastre os valores reais no hPanel.

# URL DO SITE
APP_URL=https://seu-dominio.com
NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# PAINEL ADMINISTRATIVO
ADMIN_EMAILS=admin@seu-dominio.com
ADMIN_PASSCODE=defina-uma-senha-forte
ADMIN_SESSION_SECRET=defina-um-segredo-longo-e-aleatorio

# FIREBASE CLIENT — estes valores são públicos, mas devem ser do seu projeto
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=(default)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# FIREBASE ADMIN — segredo privado server-side.
# Informe JSON compacto em uma linha ou a string JSON codificada em Base64.
# Nunca envie este valor ao cliente nem inclua serviceAccountKey.json no ZIP.
FIREBASE_ADMIN_SERVICE_ACCOUNT=
FIREBASE_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────
# Google AdSense
# ─────────────────────────────────────────────────────────────────
# A conta e ca-pub-7432900526570149 (declarada em app/layout.tsx e em
# public/ads.txt). Os IDs de slot sao publicos e ficam no HTML da pagina —
# por isso sao variaveis de ambiente, e nao codigo: trocar de slot ou de
# conta nao deve exigir deploy.
#
# Sem estas variaveis os banners nao renderizam. Isso e proposital: um
# slot vazio ocupa espaco, derruba o CLS e mostra "Publicidade" com nada
# dentro, o que e pior do que nao ter anuncio.
#
# Crie os slots no painel do AdSense como "Anuncio de exibicao" e cole os IDs.
# Nomes sugeridos ao criar:
#   ARTICLE_MIDDLE  artigo, entre a galeria e a navegacao anterior/proximo
#   ARTICLE_END     artigo, logo abaixo do corpo
#   EBIKE_SPEC      detalhe da e-bike
#   RANKING_ITEM    ranking, entre blocos de itens
#   HOME_BOTTOM     home (desktop e mobile), no rodape
#   CATALOG_FOOTER  listagem de e-bikes, no rodape
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
NEXT_PUBLIC_ADSENSE_SLOT_EBIKE_SPEC=
NEXT_PUBLIC_ADSENSE_SLOT_RANKING_ITEM=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG_FOOTER=
